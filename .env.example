# PostgreSQL
POSTGRES_URL=postgresql+asyncpg://clinicalkg:clinicalkg_password@localhost:5432/clinicalkg
POSTGRES_PASSWORD=clinicalkg_password

# Neo4j
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=clinicalkg_password

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=super_secret_clinicalkg_jwt_token_key_change_in_production_32chars
JWT_EXPIRY_SECONDS=3600

# LLM (Google GenAI Gemini)
LLM_BACKEND=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=biomistral:latest

# Storage (Relative paths for local dev, absolute in container)
UPLOAD_DIR=data/uploads
FAISS_DIR=data/faiss
MAX_UPLOAD_SIZE_MB=10

# Retrieval & Fusion Gating
EVIDENCE_MIN_SCORE=0.45
GRAPH_WEIGHT=0.6

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Environment
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
